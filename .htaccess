DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 0. Force www canonical — fixes "Page with redirect" GSC issue
  RewriteCond %{HTTP_HOST} ^tellyfilmy\.com$ [NC]
  RewriteRule ^(.*)$ https://www.tellyfilmy.com/$1 [R=301,L]

  # 1. Direct access to existing files and directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 2. Check if .html file exists for the request
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # 3. Check public_html subfolder if cloned inside public_html
  RewriteCond %{DOCUMENT_ROOT}/public_html/$1.html -f
  RewriteRule ^(.*)$ /public_html/$1.html [L]

  RewriteCond %{DOCUMENT_ROOT}/public_html/$1 -f
  RewriteRule ^(.*)$ /public_html/$1 [L]

  # 4. Route all remaining clean URLs to index.php
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ index.php [L,QSA]
</IfModule>

# Proper 404 error page
ErrorDocument 404 /404.html
