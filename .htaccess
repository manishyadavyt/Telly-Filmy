DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Route requests to public_html if folder exists
  RewriteCond %{REQUEST_URI} !^/public_html/
  RewriteCond %{DOCUMENT_ROOT}/public_html/index.html -f
  RewriteRule ^(.*)$ public_html/$1 [L,QSA]

  # 2. Direct access to existing file or directory
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Clean URLs for static HTML
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([^/]+)/?$ $1.html [L]

  RewriteCond %{DOCUMENT_ROOT}/$1/$2.html -f
  RewriteRule ^([^/]+)/([^/]+)/?$ $1/$2.html [L]

  RewriteCond %{DOCUMENT_ROOT}/$1/$2/$3.html -f
  RewriteRule ^([^/]+)/([^/]+)/([^/]+)/?$ $1/$2/$3.html [L]

  # 4. 404 handler
  ErrorDocument 404 /public_html/404.html
</IfModule>
