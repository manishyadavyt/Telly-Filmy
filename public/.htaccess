DirectoryIndex index.php index.html

# ─── PREVENT CACHING FOR DYNAMIC JSON & PHP ENDPOINTS ───
<IfModule mod_headers.c>
  # Never cache posts.json so all devices always get the latest articles immediately
  <FilesMatch "^posts\.json$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>

  # Never cache PHP endpoints
  <FilesMatch "\.(php)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

# ─── LITESPEED CACHE RULES ───
<IfModule LiteSpeed>
  RewriteEngine On
  RewriteRule ^posts\.json$ - [E=Cache-Control:no-cache]
  RewriteRule ^save-posts\.php$ - [E=Cache-Control:no-cache]
  RewriteRule ^upload\.php$ - [E=Cache-Control:no-cache]
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Direct access to existing files and directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 2. Check if .html file exists for the request
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # 3. Check public_html subfolder if cloned inside public_html
  RewriteCond %{DOCUMENT_ROOT}/public_html/$1.html -f
  RewriteRule ^(.*)$ /public_html/$1.html [L]

  RewriteCond %{DOCUMENT_ROOT}/public_html/$1 -f
  RewriteRule ^(.*)$ /public_html/$1 [L]

  # 4. Route all remaining clean URLs to index.php
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ /index.php [L,QSA]
</IfModule>
